# 后台管理员密码（GET /api/orders 全量列表、PATCH 物流状态 需此密码或 Cookie admin_token）
ADMIN_PASSWORD=dtc-admin-2024

# --- Next.js API Routes（与前端同部署，无需单独 Node 服务）---
# GET  /api/health              探活
# POST /api/orders              创建订单
# GET  /api/orders?email=       按邮箱查已支付订单（公开）
# GET  /api/orders              全量订单（需后台登录或 Bearer）
# GET  /api/orders/[id]         单条订单（公开）
# PATCH /api/orders/[id]        body: { paymentMethod } 用户确认支付（公开）| { status } 仅管理员
# POST /api/admin/login         后台登录，写入 httpOnly Cookie

# PayPal 收款账号（PayPal.me 用户名，用于支付页跳转链接）
# NEXT_PUBLIC_PAYPAL_ME=your-paypalme-username

# 支付宝/微信收款码图片（不设则使用 public/images/alipay-qr.png、wechat-qr.png；也可填完整图片 URL）
# NEXT_PUBLIC_ALIPAY_QR=/images/alipay-qr.png
# NEXT_PUBLIC_WECHAT_QR=/images/wechat-qr.png

